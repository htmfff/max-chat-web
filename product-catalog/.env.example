# --- Application ---
APP_ENV=dev
APP_DEBUG=1
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

# --- Database (docker-compose uses the "db" host) ---
DATABASE_URL=mysql://app:app@db:3306/product_catalog?serverVersion=8.4&charset=utf8mb4
MYSQL_DATABASE=product_catalog
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=28800

# --- RabbitMQ / Symfony Messenger ---
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Import ---
IMPORT_MAX_FILE_SIZE=10485760
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW=60

# --- CORS (frontend dev server origin, or * in demo mode) ---
CORS_ALLOW_ORIGIN=http://localhost:4200

# --- Seed admin credentials ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
