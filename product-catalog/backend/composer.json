{
    "name": "test-assignment/product-catalog",
    "description": "Product import/export test assignment: Slim 4 + Doctrine ORM + Symfony Messenger",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-amqp": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.3",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^5.11",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.3",
        "symfony/cache": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "symfony/messenger": "^7.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Migrations\\": "migrations/"
        },
        "files": [
            "src/Infrastructure/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "worker": "php bin/worker.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
